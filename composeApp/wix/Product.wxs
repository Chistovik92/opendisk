<?xml version="1.0" encoding="UTF-8"?>
<!--
  Установщик OpenDisk для Windows.

  Собственная сборка на WiX вместо установщика, который делает jpackage.
  Причина одна и важная: jpackage не умеет закрывать работающее приложение.
  Обновление поверх запущенной копии упиралось в занятые файлы, Windows
  Installer откладывал их замену, сам перезагружал компьютер — и установка
  оставалась повреждённой, приложение переставало запускаться.

  Файлы приложения сюда не перечисляются: их собирает heat.exe из готового
  образа (задача createDistributable) в группу компонентов AppFiles.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="OpenDisk"
           Language="1049"
           Codepage="1251"
           Version="$(var.Version)"
           Manufacturer="OpenDisk contributors"
           UpgradeCode="017F57A7-5FBD-3E70-A0A0-07906627B269">

    <!--
      InstallerVersion 500 — Windows Installer 5.0, он есть везде начиная
      с Windows 7 и нужен для perMachine-установки в 64-битный Program Files.
    -->
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="OpenDisk — открытый клиент облачных дисков"
             Manufacturer="OpenDisk contributors"
             Languages="1049"
             SummaryCodepage="1251" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      UpgradeCode совпадает с тем, что использовал jpackage, — иначе новая
      версия встала бы рядом со старой вместо обновления.

      Момент удаления старой версии здесь принципиален, и обе привычные
      настройки не подошли:

      - afterInstallInitialize теряло 18 файлов, включая jvm.dll: пути у старой
        и новой версии совпадают, установщик решал не перезаписывать «такие же»
        файлы, а последующее удаление старого продукта их сносило. Приложение
        после обновления не запускалось;
      - afterInstallValidate снимает старую версию раньше, чем успевает
        отработать закрытие приложения, — файлы оказывались заняты, и установка
        требовала перезагрузки (код 3010).

      Корень оказался не в расписании, а в GUID-ах компонентов: heat выдавал
      их заново при каждой сборке, и installer не мог сопоставить одинаковые
      файлы двух версий. Со стабильными GUID-ами (heat -ag) обычного
      afterInstallInitialize достаточно: общие файлы пересчитываются по
      ссылкам, а приложение к этому моменту уже закрыто.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="Уже установлена более новая версия OpenDisk." />

    <!-- Чтобы в «Программах и компонентах» был виден путь установки. -->
    <Property Id="ARPINSTALLLOCATION" Secure="yes" />
    <CustomAction Id="SetArpInstallLocation" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />

    <!--
      Уборка за собой при удалении.

      Настройки приложения и запись автозапуска лежат в профиле пользователя,
      а не в каталоге программы, поэтому обычным RemoveFile их не достать:
      удаление файлов идёт от имени системы, и AppDataFolder указывал бы
      в её профиль, а не в пользовательский.

      Поэтому зовём само приложение с флагом cleanup (два дефиса перед словом;
      написать их здесь нельзя — XML не допускает двойной дефис в комментарии).
      Приложение знает свои пути и убирает их само.

      Действие немедленное и без повышения прав, то есть
      выполняется от имени того, кто запустил удаление: именно его файлы и
      надо убрать.

      Before="RemoveFiles" обязателен: позже исполняемого файла уже не будет.
      Return="ignore" — если уборка почему-то не отработала, удаление всё равно
      должно дойти до конца.

      Зовём приложение не напрямую, а через powershell с пределом в минуту:
      прямой вызов ждал бы завершения без конца. Так и вышло со сборкой 0.5.0
      для ARM, у которой лаунчер не завершался вовсе: удаление и обновление
      поверх неё вешались навсегда, и вылечить это можно было только
      завершением процесса вручную. Минуты уборке хватает с запасом: это
      удаление нескольких файлов в профиле.

      При обновлении уборки быть не должно (NOT UPGRADINGPRODUCTCODE): старая
      версия снимается с флагом REMOVE=ALL, как при удалении, и до 0.5.9
      каждое обновление стирало настройки — буквы дисков, язык, тему — и
      выключало автозапуск.

      Список облаков (rclone.conf) и WinFsp здесь не трогаются: первое — данные
      пользователя, вторым могут пользоваться другие программы. Их удаление
      предлагается в самом приложении, где можно спросить.
    -->
    <CustomAction Id="CleanUserData"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;$p = Start-Process -FilePath '[INSTALLDIR]OpenDisk.exe' -ArgumentList '--cleanup' -PassThru; if (-not $p.WaitForExit(60000)) { $p.Kill() }&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopOpenDisk" Before="InstallValidate" />
      <Custom Action="BackupUserSettings" After="StopOpenDisk">WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="SetArpInstallLocation" After="InstallValidate">NOT Installed</Custom>
      <Custom Action="CleanUserData" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RestoreUserSettings" After="InstallFinalize">WIX_UPGRADE_DETECTED AND NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <!--
      Ради этого всё и затевалось: установщик закрывает работающий OpenDisk
      до того, как трогать файлы.

      Раньше это делал util:CloseApplication, и в 0.5.8 он опаздывал. Его
      закрытие стоит перед InstallFiles, а старая версия (MajorUpgrade
      afterInstallInitialize) снимается раньше — пока приложение ещё работает.
      Сообщение WM_CLOSE его не завершает, окно только прячется в трей; все jar
      и runtime\lib\modules заняты, и Windows Installer откладывает их
      удаление до перезагрузки. Новая версия тут же кладёт файлы с теми же
      именами, а после перезагрузки система удаляет уже их: от образа
      оставались три файла из пятидесяти, и приложение не запускалось.

      Поэтому закрываем сами и раньше всего — перед InstallValidate, где
      Windows Installer проверяет занятые файлы. Действие немедленное: так оно
      успевает до снятия старой версии, которое запускается внутри
      InstallInitialize.

      Закрываются только OpenDisk.exe и rclone.exe из каталога установки:
      rclone, запущенный пользователем отдельно, установщик больше не трогает.
      Приложение завершается принудительно, его shutdown-hook не отработает,
      поэтому rclone закрываем вместе с ним — иначе он пережил бы родителя
      и держал собственный файл. Ждём завершения, иначе файлы ещё заняты.

      Return="ignore": не нашлось процессов или не хватило прав — установка
      всё равно продолжается, дальше сработает обычная проверка занятых файлов.

      PowerShell — 64-битный ([System64Folder]), а путь к процессу берётся из
      Win32_Process. В первой версии этого действия стоял [SystemFolder]: в
      64-битном пакете это SysWOW64, 32-битный PowerShell не видит пути
      64-битных процессов (Process.Path пустой), и фильтр по каталогу
      установки молча не находил никого. Поймала проверка «обновление поверх
      работающей копии» в CI.
    -->
    <CustomAction Id="StopOpenDisk"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;$d = '[INSTALLDIR]'.ToLower(); if ($d) { $ids = Get-CimInstance Win32_Process | Where-Object { ($_.Name -eq 'OpenDisk.exe' -or $_.Name -eq 'rclone.exe') -and $_.ExecutablePath -and $_.ExecutablePath.ToLower().StartsWith($d) } | ForEach-Object { $_.ProcessId }; foreach ($id in $ids) { $p = Get-Process -Id $id -ErrorAction SilentlyContinue; if ($p) { $p.Kill(); $null = $p.WaitForExit(30000) } } }&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!--
      Настройки пользователя при обновлении.

      Версии до 0.5.8 включительно при снятии в ходе обновления запускают
      уборку и стирают каталог настроек. Их установщик уже на компьютере,
      и поменять его нельзя, поэтому новая версия сохраняет каталог до снятия
      старой и возвращает после, если его стёрли. Если не стёрли — копия
      просто удаляется.

      Автозапуск приложение восстанавливает само: галка в настройках
      сохраняется, а запись в реестре при старте сверяется с ней.
    -->
    <CustomAction Id="BackupUserSettings"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;$s = Join-Path $env:APPDATA 'opendisk'; $b = Join-Path $env:APPDATA 'opendisk.upgrade'; if (Test-Path -LiteralPath $s) { Remove-Item -LiteralPath $b -Recurse -Force -ErrorAction SilentlyContinue; Copy-Item -LiteralPath $s -Destination $b -Recurse -Force }&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />
    <CustomAction Id="RestoreUserSettings"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;$s = Join-Path $env:APPDATA 'opendisk'; $b = Join-Path $env:APPDATA 'opendisk.upgrade'; if (Test-Path -LiteralPath $b) { if (-not (Test-Path -LiteralPath $s)) { Move-Item -LiteralPath $b -Destination $s } else { Remove-Item -LiteralPath $b -Recurse -Force } }&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Перезагрузка не должна происходить сама по себе ни при каких условиях. -->
    <Property Id="REBOOT" Value="ReallySuppress" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="OpenDisk" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="OpenDisk" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuLink"
                  Name="OpenDisk"
                  Description="Открытый клиент облачных дисков"
                  Target="[INSTALLDIR]OpenDisk.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <!-- Ярлыку нужен keypath; для машинной установки берём HKLM. -->
        <RegistryValue Root="HKLM" Key="Software\OpenDisk"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopLink"
                  Name="OpenDisk"
                  Description="Открытый клиент облачных дисков"
                  Target="[INSTALLDIR]OpenDisk.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKLM" Key="Software\OpenDisk"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="OpenDisk" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!--
      Галка «Запустить OpenDisk» на последней странице.

      Отмечена по умолчанию: и после первой установки, и после обновления
      человек ожидает увидеть работающее приложение. При обновлении это
      особенно заметно — установщик перед заменой файлов сам закрывает
      работающую копию, и без запуска она бы просто исчезла.

      Путь задаётся отдельным действием, а не значением свойства: значения
      свойств не разворачиваются во время работы, и [INSTALLDIR] осталось бы
      подстрокой.

      Impersonate="yes" обязателен — иначе приложение запустилось бы от имени
      системы и не увидело бы ни настроек пользователя, ни его рабочего стола.
      Ждать закрытия приложения установщику не нужно, но это забота самого
      WixShellExec: он только запускает и сразу возвращает управление.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить OpenDisk" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction Id="SetLaunchTarget"
                  Property="WixShellExecTarget"
                  Value="[INSTALLDIR]OpenDisk.exe" />
    <CustomAction Id="LaunchApplication"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="SetLaunchTarget" Order="1">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed
      </Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication" Order="2">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed
      </Publish>
    </UI>
  </Product>
</Wix>
