<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Один apk на телефоны, планшеты, приставки Android TV и часы Wear OS.
      Ни сенсорный экран, ни телевизор, ни часы не обязательны: без
      required="false" магазины и установщики отказали бы устройствам, у
      которых этого нет, — телевизор без сенсора, телефон без пульта.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <!-- Встроенный файловый менеджер (0.5.6): память телефона как диск рядом
         с облаками — открыть, скачать из облака, залить в облако.
         С Android 11 всё, кроме медиа, открывает только «доступ ко всем
         файлам»; до него хватает обычных чтения и записи. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Значок в шторке со сводкой подключений. С Android 13 разрешение
         спрашивается у человека; отказ ничего не ломает, кроме самого значка. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Служба переднего плана со значком в шторке, пока облака подключены
         или идёт вход через браузер. Фоновому приложению телефон может
         отрезать сеть, и вход падал с «no such host». См. StatusService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="OpenDisk"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenDisk">

        <!-- Часы: приложение самостоятельное, телефон рядом не нужен —
             rclone и облака живут на самих часах. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="OpenDisk"
            android:theme="@style/Theme.OpenDisk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Значок на главном экране Android TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          dataSync — до Android 14, дальше specialUse: с Android 15 у dataSync
          предел в шесть часов в сутки, а подключённое облако работает дольше.
        -->
        <service
            android:name=".StatusService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Отдаёт подключённые облака системному выбору файлов и держит сервер подтверждения входа через браузер" />
        </service>

        <!-- Файл из встроенного файлового менеджера открывается в другом
             приложении по адресу content://, а не по пути: чужому приложению
             наши файлы по пути не прочитать. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Подключённые облака для всей системы: «Файлы» и любое окно выбора
          файла спрашивают их здесь. Разрешение MANAGE_DOCUMENTS выдаётся
          только системному приложению выбора файлов — так и задумано:
          остальным приложениям корни видны лишь через него, по выбору
          человека.
        -->
        <provider
            android:name=".OpenDiskDocumentsProvider"
            android:authorities="com.opendisk.android.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
