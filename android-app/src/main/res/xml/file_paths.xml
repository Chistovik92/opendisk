<?xml version="1.0" encoding="utf-8"?>
<!--
  Что встроенный файловый менеджер может отдать другим приложениям:
  файлы в памяти телефона и на картах (они открываются на месте) и копии
  из облаков и из-под root в кэше приложения. root-path покрывает всё это
  одной строкой: карта памяти монтируется по пути, который заранее не известен.
-->
<paths>
    <root-path name="device" path="/" />
    <cache-path name="cache" path="." />
</paths>
