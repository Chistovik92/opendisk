<?xml version="1.0" encoding="utf-8"?>
<!--
  Открытый HTTP — только до самого телефона.

  Чтение больших файлов кусками (CloudStreams) идёт по HTTP на сервер rclone
  внутри приложения: 127.0.0.1, случайный порт, пароль. Android с версии 9
  запрещает открытый HTTP по умолчанию, и без этого исключения запрос
  обрывался с «Cleartext HTTP traffic not permitted». Разрешён один адрес,
  не весь интернет: всё остальное, включая облака, как и раньше только по HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
