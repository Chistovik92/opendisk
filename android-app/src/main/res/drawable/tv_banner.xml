<?xml version="1.0" encoding="utf-8"?>
<!--
  Баннер на главном экране Android TV (320×180 dp). Без него приставка
  показывает вместо приложения пустую плитку, а на части прошивок не
  показывает вовсе. Значок приложения по центру на фирменном фоне.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#1F4E8C" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
